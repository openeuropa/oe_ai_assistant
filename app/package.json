{
  "name": "ai-editorial-assistant",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,yellow \"vite\" \"tsx watch server/index.ts --drafting-mode=mock\"",
    "dev:integration": "concurrently -n vite,api -c cyan,yellow \"vite\" \"tsx watch server/index.ts --drafting-mode=mistral\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts --drafting-mode=mock",
    "dev:server:integration": "tsx watch server/index.ts --drafting-mode=mistral",
    "build": "tsc -b && vite build --emptyOutDir && node scripts/build-schemas.js",
    "build:schemas": "node scripts/build-schemas.js",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test:unit": "vitest run --project unit",
    "api:generate": "openapi-typescript api/openapi.yaml -o src/api/schema.d.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.19",
    "@assistant-ui/react-data-stream": "^0.12.8",
    "@assistant-ui/react-markdown": "^0.12.6",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "lucide-react": "^0.577.0",
    "mitt": "^3.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.5",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.1",
    "@biomejs/biome": "^2.4.6",
    "@chromatic-com/storybook": "^5.0.1",
    "@mistralai/mistralai": "^2.1.0",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-onboarding": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@tailwindcss/vite": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.58.2",
    "storybook": "^10.2.17",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
