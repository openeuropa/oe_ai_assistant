{
    "name": "openeuropa/oe_ai_assistant",
    "type": "drupal-module",
    "description": "OpenEuropa AI Editorial Assistant",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "cortexphp/json-repair": "^0.4",
        "cweagans/composer-patches": "^2.0",
        "drupal/ai": "^1.3",
        "drupal/ai_agents": "^1.3@beta",
        "drupal/ai_provider_mistral": "^1.1@RC",
        "justinrainbow/json-schema": "^5.0 || ^6.0",
        "swisnl/ag-ui-server": "^0.5",
        "symfony/ai-agent": "^0.6",
        "symfony/ai-platform": "^0.6"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "drupal/agui": "^1.0@RC",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-dev": "^11",
        "drupal/seven": "^2.0",
        "drupal/paragraphs": "^1.0",
        "drupal/entity_reference_revisions": "^1.0",
        "drupal/inline_entity_form": "^3.0",
        "weitzman/drupal-test-traits": "^2.0",
        "drush/drush": "^13.0",
        "drupal/coder": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\oe_ai_assistant\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_ai_assistant\\": "./tests/src/"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patches": {
            "drupal/ai": {
                "#3579967: Buffer corrupts HTML with relative URLs in streamed responses": "patches/ai-3579967-streaming-buffer-relative-urls.patch"
            },
            "drupal/ai_provider_mistral": {
                "Streaming chunk loss: advance-before-yield overwrites shared Response object": "patches/ai-provider-mistral-streaming-chunk-loss.patch"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./web"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
