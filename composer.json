{
    "name": "openeuropa/oe_ai_assistant",
    "type": "drupal-module",
    "description": "OpenEuropa AI Editorial Assistant",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "cortexphp/json-repair": "^0.4",
        "cweagans/composer-patches": "^1 || ^2",
        "drupal/ai": "^1.3",
        "drupal/document_loader": "^2.0",
        "drupal/key": "^1.22",
        "drupal/state_machine": "^1.14",
        "justinrainbow/json-schema": "^6.0",
        "neuron-core/neuron-ai": "^3.17"
    },
    "require-dev": {
        "openeuropa/oe_ai_provider_gpt_at_ec": "^1.0.0-alpha",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/entity_reference_revisions": "^1.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/paragraphs": "^1.0",
        "drupal/seven": "^2.0",
        "weitzman/drupal-test-traits": "^2.0",
        "drush/drush": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\oe_ai_assistant\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_ai_assistant\\": "./tests/src/"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patches": {
            "drupal/ai": {
                "HostnameFilter breaks HTML in JSON (@see https://git.drupalcode.org/project/ai/-/work_items/3586677)": "https://raw.githubusercontent.com/openeuropa/oe_ai_assistant/62ecddfe24c1b00d150f3187caac192accd7d32e/patches/ai-hostname-filter-handling-of-html-in-json.patch"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./web"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    }
}
