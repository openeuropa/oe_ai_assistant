{
    "name": "openeuropa/oe_ai_assistant",
    "type": "drupal-module",
    "description": "OpenEuropa AI Editorial Assistant",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "cortexphp/json-repair": "^0.4",
        "cweagans/composer-patches": "^1 || ^2",
        "drupal/ai": "^1.3",
        "drupal/ai_agents": "^1.3@beta",
        "drupal/ai_provider_mistral": "^1.1@RC",
        "justinrainbow/json-schema": "^5.0 || ^6.0"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-dev": "^11",
        "drupal/entity_reference_revisions": "^1.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/paragraphs": "^1.0",
        "drupal/seven": "^2.0",
        "weitzman/drupal-test-traits": "^2.0",
        "drush/drush": "^13.0",
        "drupal/logger": "^1.0@alpha",
        "drupal/tool": "^1.0@beta",
        "drupal/extended_logger": "^1.3@beta",
        "drupal/coder": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\oe_ai_assistant\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_ai_assistant\\": "./tests/src/"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patches": {
            "drupal/ai_provider_mistral": {
                "Return proper ToolsFunctionOutput objects from streaming tool calls": "patches/ai-provider-mistral-streaming-tool-calls.patch"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./web"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
