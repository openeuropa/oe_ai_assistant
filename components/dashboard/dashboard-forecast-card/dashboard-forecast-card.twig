<section class="ai-dashboard-forecast-card">
  <div class="ai-dashboard-forecast-card__overview">
    {% if eyebrow %}<p class="ai-dashboard-forecast-card__eyebrow">{{ eyebrow }}</p>{% endif %}
    <h2 class="ai-dashboard-forecast-card__heading">{{ heading }}</h2>
    {% if description %}<p class="ai-dashboard-forecast-card__description">{{ description }}</p>{% endif %}
    <progress class="ai-dashboard-forecast-card__progress" value="{{ progress|default(0) }}" max="100">{{ progress|default(0) }}%</progress>
    {% if usage_summary %}<p class="ai-dashboard-forecast-card__usage-summary">{{ usage_summary }}</p>{% endif %}
  </div>
  <div class="ai-dashboard-forecast-card__details">
    <div class="ai-dashboard-forecast-card__stat">
      <p>{{ 'Month to date spend'|t }}</p>
      <strong>{{ spent }}</strong>
      {% if spent_trend %}<span class="ai-dashboard-forecast-card__trend">{{ spent_trend }}</span>{% endif %}
    </div>
    <div class="ai-dashboard-forecast-card__stat">
      <p>{{ 'Monthly forecast'|t }}</p>
      <strong>{{ forecast }}</strong>
      {% if forecast_status %}<span class="ai-dashboard-forecast-card__status">{{ forecast_status }}</span>{% endif %}
    </div>
    <div class="ai-dashboard-forecast-card__action">
      <p>{{ 'Forecast action'|t }}</p>
      {{ action }}
    </div>
    {% if billing_cycle %}<div class="ai-dashboard-forecast-card__cycle"><p>{{ 'Billing cycle'|t }}</p><span>{{ billing_cycle }}</span></div>{% endif %}
  </div>
</section>
