<div class="ai-dashboard{{ variant == 'table' ? ' ai-dashboard--table' : '' }}">
  <header class="ai-dashboard__header">{{ header }}</header>
  <div class="ai-dashboard__filters">{{ filters }}</div>
  <div class="ai-dashboard__period-controls">{{ period_controls }}</div>
  <div class="ai-dashboard__forecast">{{ forecast }}</div>
  <div class="ai-dashboard__metrics">{{ metrics }}</div>
  <div class="ai-dashboard__breakdowns">{{ breakdowns }}</div>
  <div class="ai-dashboard__supplementary">{{ supplementary }}</div>
</div>
