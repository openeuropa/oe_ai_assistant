+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\ai_neuron\Drush\Commands;
+
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drush\Attributes as CLI;
+use Drush\Commands\DrushCommands;
+use NeuronAI\Console\Evaluation\EvaluationCommand;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Runs Neuron AI evaluators.
+ */
+final class NeuronEvaluationCommands extends DrushCommands {
+
+  public function __construct(
+    private readonly ModuleHandlerInterface $moduleHandler,
+    private readonly string $appRoot,
+  ) {
+    parent::__construct();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container): self {
+    return new self(
+      $container->get('module_handler'),
+      $container->getParameter('app.root'),
+    );
+  }
+
+  /**
+   * Runs the Neuron AI evaluators an enabled contrib or custom module ships.
+   *
+   * @return int
+   *   0 if every evaluator passed, 1 otherwise - the same contract
+   *   EvaluationCommand::run() reports to the standalone CLI.
+   */
+  #[CLI\Command(name: 'ai-neuron:evaluate', aliases: ['neuron-evaluate'])]
+  #[CLI\Argument(name: 'path', description: "Directory to discover evaluators in. Defaults to every enabled contrib/custom module's own evaluators/ directory.")]
+  #[CLI\Option(name: 'concurrency', description: 'Run dataset items in N parallel processes (requires pcntl, posix and spatie/fork).')]
+  #[CLI\Option(name: 'cache', description: 'Serve unchanged run() outputs from the evaluation cache.')]
+  #[CLI\Option(name: 'fresh', description: 'Re-run everything and overwrite the evaluation cache.')]
+  #[CLI\Usage(name: 'drush ai-neuron:evaluate', description: "Runs every enabled contrib/custom module's evaluators/ directory.")]
+  #[CLI\Usage(name: 'drush ai-neuron:evaluate web/modules/custom/my_module/evaluators', description: 'Runs one directory only.')]
+  public function evaluate(
+    ?string $path = NULL,
+    array $options = [
+      'concurrency' => 1,
+      'cache' => FALSE,
+      'fresh' => FALSE,
+    ],
+  ): int {
+    if ($path !== NULL) {
+      $directories = [$path];
+    }
+    else {
+      $candidates = $this->candidateDirectories();
+      $directories = array_values(array_filter($candidates, 'is_dir'));
+
+      if ($directories === []) {
+        $this->io()->warning(sprintf(
+          "No evaluators directory found in any enabled contrib/custom module. The following paths were checked:\n%s",
+          implode("\n", array_map(static fn (string $candidate): string => "  - {$candidate}", $candidates)),
+        ));
+        return 0;
+      }
+    }
+
+    $exitCode = 0;
+    foreach ($directories as $directory) {
+      if (count($directories) > 1) {
+        $this->io()->section($directory);
+      }
+
+      $exitCode = max($exitCode, (new EvaluationCommand())->run($this->commandArgs($directory, $options)));
+    }
+
+    return $exitCode;
+  }
+
+  /**
+   * Builds the argv-style array EvaluationCommand::run() expects.
+   *
+   * @return array<string>
+   *   The argv-style array.
+   */
+  private function commandArgs(string $directory, array $options): array {
+    $args = ['ai-neuron:evaluate', $directory, '--verbose'];
+
+    if ((int) $options['concurrency'] > 1) {
+      $args[] = '--concurrency=' . (int) $options['concurrency'];
+    }
+    if ($options['cache']) {
+      $args[] = '--cache';
+    }
+    if ($options['fresh']) {
+      $args[] = '--fresh';
+    }
+
+    return $args;
+  }
+
+  /**
+   * Builds every enabled non-core module's candidate evaluators directory path.
+   *
+   * @return string[]
+   *   The candidate directory paths.
+   */
+  private function candidateDirectories(): array {
+    $directories = [];
+    foreach ($this->moduleHandler->getModuleList() as $module) {
+      if (str_starts_with($module->getPath(), 'core/')) {
+        // No core noise needed, skip it. It will never ship evaluators.
+        continue;
+      }
+
+      $directories[] = $this->appRoot . '/' . $module->getPath() . '/evaluators';
+    }
+
+    return $directories;
+  }
+
+}
