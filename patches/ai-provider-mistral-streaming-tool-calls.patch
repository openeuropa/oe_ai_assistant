     }
   }
 
+  /**
+   * {@inheritdoc}
+   *
+   * Builds ToolsFunctionOutput objects from the collected tool calls
+   * instead of relying on assembleToolCalls().
+   */
+  public function getTools(): array {
+    if (empty($this->collectedToolCalls)) {
+      return [];
+    }
+
+    $tools = [];
+    foreach ($this->collectedToolCalls as $toolCall) {
+      $arguments = $toolCall['function']['arguments'] ?? [];
+      if (is_string($arguments)) {
+        $arguments = json_decode($arguments, TRUE) ?? [];
+      }
+      $output = new ToolsFunctionOutput(
+        NULL,
+        $toolCall['id'] ?? '',
+        $arguments,
+      );
+      $output->setName($toolCall['function']['name'] ?? '');
+      $tools[] = $output;
+    }
+
+    return $tools;
+  }
