+      }
+
       $streamedMessage = $this->createStreamedChatMessage(
         $message->getRole() ?? 'assistant',
         $response->getChunk() ?? '',
         $metadata,
-        $toolCalls && !$toolCalls->isEmpty() ? $toolCalls->toArray() : NULL,
