diff --git a/tests/src/Kernel/Plugin/ProviderProxyStructuredJsonFilterTest.php b/tests/src/Kernel/Plugin/ProviderProxyStructuredJsonFilterTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..bbf97e9244d31f6f64f4d9dcf0584ef66d025acc
--- /dev/null
+++ b/tests/src/Kernel/Plugin/ProviderProxyStructuredJsonFilterTest.php
@@ -0,0 +1,122 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\ai\Kernel\Plugin;
+
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\ai\OperationType\Chat\ChatInput;
+use Drupal\ai\OperationType\Chat\ChatMessage;
+use Drupal\ai\OperationType\Chat\ChatOutput;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests that structured output responses survive the hostname filter.
+ *
+ * Regression test for issue #3586677: a chat response requested with a
+ * structured output schema is a JSON payload, and pushing it through the
+ * HTML5 round trip in HostnameFilter entity-encoded it beyond decoding —
+ * even when every URL in it was on the allowlist. ProviderProxy now puts
+ * the filter in JSON mode for such responses, and the filter itself
+ * detects JSON payloads and filters their string values individually.
+ *
+ * @group ai
+ */
+#[RunTestsInSeparateProcesses]
+class ProviderProxyStructuredJsonFilterTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'ai',
+    'ai_test',
+    'key',
+    'file',
+    'user',
+    'field',
+    'system',
+  ];
+
+  /**
+   * The hostname filter service.
+   *
+   * @var \Drupal\ai\Service\HostnameFilter
+   */
+  protected $hostnameFilter;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('file');
+    $this->installSchema('file', ['file_usage']);
+    $this->installConfig(['ai', 'ai_test']);
+    $this->installEntitySchema('ai_mock_provider_result');
+
+    // Pin the singleton to a known starting state.
+    $this->hostnameFilter = $this->container->get('ai.hostname_filter_service');
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+  }
+
+  /**
+   * Build a ChatInput with the structured schema the YAML fixtures match.
+   */
+  protected function buildStructuredInput(string $trigger): ChatInput {
+    $input = new ChatInput([
+      new ChatMessage('user', $trigger),
+    ]);
+    $input->setChatStructuredJsonSchema([
+      'name' => 'content_item',
+      'schema' => [
+        'type' => 'object',
+        'properties' => [
+          'title' => ['type' => 'string'],
+          'body' => ['type' => 'string'],
+        ],
+        'required' => ['title', 'body'],
+      ],
+    ]);
+    return $input;
+  }
+
+  /**
+   * A clean structured payload passes through byte-for-byte and decodes.
+   */
+  public function testCleanStructuredJsonResponseIsNotCorrupted(): void {
+    $provider = $this->container->get('ai.provider')->createInstance('echoai');
+    $output = $provider->chat($this->buildStructuredInput('structured-json-filter-test-trigger'), 'gpt-test');
+
+    $this->assertInstanceOf(ChatOutput::class, $output);
+    $text = $output->getNormalized()->getText();
+    $expected = '{"title":"Hello","body":"<p>Text <a href=\"https://example.com/a\">ok</a> &amp; x < y</p>","count":5,"empty":{}}';
+    $this->assertSame($expected, $text);
+
+    $decoded = json_decode($text, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertSame('Hello', $decoded['title']);
+    $this->assertSame(5, $decoded['count']);
+  }
+
+  /**
+   * A disallowed URL in a structured payload is filtered, JSON preserved.
+   */
+  public function testEvilUrlInStructuredJsonResponseIsFilteredButDecodable(): void {
+    $provider = $this->container->get('ai.provider')->createInstance('echoai');
+    $output = $provider->chat($this->buildStructuredInput('structured-json-filter-evil-test-trigger'), 'gpt-test');
+
+    $this->assertInstanceOf(ChatOutput::class, $output);
+    $text = $output->getNormalized()->getText();
+    $this->assertStringNotContainsString('evil.com', $text);
+
+    $decoded = json_decode($text, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertSame('T', $decoded['title']);
+    $this->assertStringContainsString('click', $decoded['body']);
+    // The empty object shape survives the re-encode.
+    $this->assertStringContainsString('"empty":{}', $text);
+  }
+
+}
diff --git a/tests/src/Unit/Service/HostnameFilterTest.php b/tests/src/Unit/Service/HostnameFilterTest.php
