+  protected function filterJsonStructure(array|object &$data, int $depth, bool &$modified): void {
+    if (is_object($data)) {
+      foreach (get_object_vars($data) as $key => $value) {
+        $new_key = $this->filterJsonKey((string) $key, $modified);
+        $this->filterJsonValue($value, $depth, $modified);
+        if ($new_key !== (string) $key) {
+          unset($data->{$key});
+          $data->{$new_key} = $value;
+        }
+        else {
+          $data->{$key} = $value;
+        }
+      }
+      return;
+    }
