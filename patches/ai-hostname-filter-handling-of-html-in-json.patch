+++ b/tests/src/Unit/Service/HostnameFilterTest.php
@@ -615,6 +615,7 @@ HTML;
       'rewriteLinks' => TRUE,
       'fullTrust' => FALSE,
       'plainTextMode' => FALSE,
+      'jsonMode' => TRUE,
     ];
 
     $dto = HostnameFilterDto::create($data);
@@ -622,6 +623,7 @@ HTML;
