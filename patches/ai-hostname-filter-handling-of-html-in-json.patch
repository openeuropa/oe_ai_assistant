+      $new_key = is_string($key) ? $this->filterJsonKey($key, $modified) : $key;
+      $this->filterJsonValue($value, $depth, $modified);
+      $rebuilt[$new_key] = $value;
+    }
+    $data = $rebuilt;
+  }
+
+  /**
+   * Filter a single decoded JSON value in place.
+   *
+   * @param mixed $value
+   *   The value to filter, modified in place.
+   * @param int $depth
+   *   Current recursion depth for nested JSON-in-string values.
+   * @param bool $modified
+   *   Set to TRUE when the value was changed by filtering.
+   */
+  protected function filterJsonValue(mixed &$value, int $depth, bool &$modified): void {
+    if (is_array($value) || is_object($value)) {
+      $this->filterJsonStructure($value, $depth, $modified);
+      return;
+    }
+    if (!is_string($value)) {
+      return;
+    }
+    // A string value can itself be a serialized JSON document (tool
+    // arguments commonly are); preserve its structure too.
+    $nested = $this->filterJsonText($value, $depth + 1);
+    if ($nested !== NULL) {
+      if ($nested !== $value) {
+        $value = $nested;
+        $modified = TRUE;
+      }
+      return;
+    }
+    $value_modified = FALSE;
+    $filtered = $this->filterScalarString($value, $value_modified);
+    if ($value_modified) {
+      $value = $filtered;
+      $modified = TRUE;
+    }
+  }
+
+  /**
+   * Filter a JSON object key.
+   *
+   * @param string $key
+   *   The key to filter.
+   * @param bool $modified
+   *   Set to TRUE when the key was changed by filtering.
+   *
+   * @return string
+   *   The filtered key.
+   */
+  protected function filterJsonKey(string $key, bool &$modified): string {
+    $key_modified = FALSE;
+    $filtered = $this->filterScalarString($key, $key_modified);
+    if ($key_modified) {
+      $modified = TRUE;
+      return $filtered;
+    }
+    return $key;
+  }
+
+  /**
+   * Filter a single plain string through the Markdown and HTML pipelines.
+   *
+   * Unlike ::filterText(), the input is only rewritten when a disallowed
+   * URL or dangerous construct was actually found: the HTML5 serializer
+   * output is used only when the DOM walk reported a modification, so
+   * benign strings (including ones with stray "<" or "&") pass through
+   * byte-for-byte instead of being entity-encoded by the round trip.
+   *
+   * @param string $value
+   *   The string to filter.
+   * @param bool $modified
+   *   Set to TRUE when filtering changed the string, FALSE otherwise.
+   *
+   * @return string
+   *   The filtered string, or the original string when nothing was found.
+   */
+  protected function filterScalarString(string $value, bool &$modified): string {
+    $modified = FALSE;
+    $filtered = $this->filterMarkdownLinks($value);
+    // The Markdown callbacks return the match untouched when the URL is
+    // allowed, so a difference here always means a violation was handled.
+    $md_modified = ($filtered !== $value);
+
+    // Without "<" the HTML5 fragment contains no elements, so the DOM
+    // filter cannot find anything; skip the expensive parse.
+    $html_modified = FALSE;
+    if (str_contains($filtered, '<')) {
+      $dom = $this->html5->loadHTMLFragment($filtered);
+      $html_modified = $this->filterHtmlLinks($dom);
+      if ($html_modified) {
+        $filtered = $this->html5->saveHTML($dom);
+      }
+    }
+
+    $modified = $md_modified || $html_modified;
+    return $modified ? $filtered : $value;
+  }
+
   /**
    * Filter Markdown links and images.
    *
