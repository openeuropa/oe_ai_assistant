     $array = $dto->toArray();
     $this->assertEquals($data, $array);
@@ -1925,4 +1927,320 @@ TEXT;
     ];
   }
 
+  /**
+   * Test that a clean JSON payload with an HTML value passes byte-for-byte.
+   *
+   * This is the core regression test for issue #3586677: the HTML5 round
+   * trip used for prose responses entity-encodes JSON payloads beyond
+   * decoding, even when every URL in them is allowed.
+   */
+  public function testJsonWithHtmlValueIsPreservedByteForByteWhenClean(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"title":"Hello","body":"<p>Text <a href=\"https://example.com/a\">ok</a> &amp; x < y</p>","count":5,"empty":{}}';
+    $this->assertSame($json, $this->hostnameFilter->filterText($json));
+  }
+
+  /**
+   * Test that benign angle brackets and ampersands in values are preserved.
+   */
+  public function testJsonValueWithBenignAngleBracketsPreserved(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"note":"a < b && \"q\" > c","other":"5 & 6"}';
+    $this->assertSame($json, $this->hostnameFilter->filterText($json));
+  }
+
+  /**
+   * Test that whitespace-padded JSON is still detected and preserved.
+   */
+  public function testWhitespacePaddedJsonIsDetected(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = "\n  {\"a\": \"<p>fine</p>\"}\n";
+    $this->assertSame($json, $this->hostnameFilter->filterText($json));
+  }
+
+  /**
+   * Test that a disallowed HTML link inside a JSON value is filtered.
+   */
+  public function testJsonWithDisallowedHtmlLinkInValueIsFilteredAndDecodable(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"body":"<p><a href=\"https://evil.com/x\">click</a></p>","safe":"<p>Hi</p>"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('click', $decoded['body']);
+    // Values without violations are untouched.
+    $this->assertSame('<p>Hi</p>', $decoded['safe']);
+  }
+
+  /**
+   * Test that a disallowed Markdown link inside a JSON value is filtered.
+   */
+  public function testJsonWithDisallowedMarkdownLinkInValueIsFiltered(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"summary":"See [docs](https://evil.com/docs) for details"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertSame('See docs for details', $decoded['summary']);
+  }
+
+  /**
+   * Test that a script tag inside a JSON value is removed.
+   */
+  public function testJsonScriptTagInValueIsRemoved(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"body":"before<script src=\"https://evil.com/x.js\"></script>after"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertStringNotContainsString('script', $result);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('before', $decoded['body']);
+    $this->assertStringContainsString('after', $decoded['body']);
+  }
+
+  /**
+   * Test that link rewriting works inside JSON values and stays decodable.
+   */
+  public function testJsonRewriteLinksRewritesInsideValues(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $this->hostnameFilter->setRewriteLinks(TRUE);
+    $json = '{"body":"<a href=\"https://evil.com/x\">click</a>"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    // The link text is rewritten to the URL itself.
+    $this->assertStringContainsString('https://evil.com/x</a>', $decoded['body']);
+  }
+
+  /**
+   * Test that a violation in a JSON object key is filtered.
+   */
+  public function testJsonWithViolationInObjectKeyIsFiltered(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"[x](https://evil.com/k)":"value"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertSame(['x' => 'value'], $decoded);
+  }
+
+  /**
+   * Test that a JSON document nested in a string value is filtered.
+   */
+  public function testNestedJsonStringValueWithViolationIsFiltered(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $inner = json_encode(['desc' => '<a href="https://evil.com/x">c</a>', 'keep' => 'plain']);
+    $json = json_encode(['args' => $inner]);
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $inner_decoded = json_decode($decoded['args'], TRUE);
+    $this->assertIsArray($inner_decoded);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertSame('plain', $inner_decoded['keep']);
+  }
+
+  /**
+   * Test that empty object and array shapes survive the re-encode.
+   */
+  public function testJsonEmptyObjectAndEmptyArrayShapesSurviveReencode(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"o":{},"a":[],"evil":"<a href=\"https://evil.com/x\">x</a>"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('"o":{}', $result);
+    $this->assertStringContainsString('"a":[]', $result);
+  }
+
+  /**
+   * Test that scalar JSON values survive the re-encode with their types.
+   */
+  public function testJsonScalarValuesSurviveReencode(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"i":5,"f":1.5,"z":1.0,"b":true,"n":null,"evil":"<a href=\"https://evil.com/x\">x</a>"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertSame(5, $decoded['i']);
+    $this->assertSame(1.5, $decoded['f']);
+    $this->assertSame(1.0, $decoded['z']);
+    $this->assertTrue($decoded['b']);
+    $this->assertNull($decoded['n']);
+    // JSON_PRESERVE_ZERO_FRACTION keeps 1.0 a float in the serialized form.
+    $this->assertStringContainsString('"z":1.0', $result);
+  }
+
+  /**
+   * Test that unicode survives the re-encode unescaped.
+   */
+  public function testJsonUnicodeAndEmojiSurviveReencodeUnescaped(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"text":"café 😀 naïve","evil":"<a href=\"https://evil.com/x\">x</a>"}';
+    $result = $this->hostnameFilter->filterText($json);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('café 😀 naïve', $result);
+  }
+
+  /**
+   * Test that violations deep in a nested structure are filtered.
+   */
+  public function testJsonDeeplyNestedStructureFiltered(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = json_encode([
+      'level1' => [
+        'level2' => [
+          ['body' => '<a href="https://evil.com/deep">x</a>'],
+          ['body' => '<a href="https://example.com/ok">y</a>'],
+        ],
+      ],
+    ]);
+    $result = $this->hostnameFilter->filterText($json);
+    $decoded = json_decode($result, TRUE);
+    $this->assertIsArray($decoded);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('https://example.com/ok', $result);
+  }
+
+  /**
+   * Test that top-level scalar JSON takes the regular prose path.
+   */
+  public function testTopLevelScalarJsonTakesNormalPath(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $this->assertSame('"Hello world."', $this->hostnameFilter->filterText('"Hello world."'));
+    $this->assertSame('123', $this->hostnameFilter->filterText('123'));
+  }
+
+  /**
+   * Test that non-JSON text starting with a bracket is still filtered.
+   */
+  public function testNonJsonTextStartingWithBracketTakesNormalPath(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $result = $this->hostnameFilter->filterText('[click](https://evil.com/page) more text');
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('click', $result);
+    $this->assertStringContainsString('more text', $result);
+  }
+
+  /**
+   * Test that a clean fenced JSON block passes byte-for-byte.
+   */
+  public function testFencedJsonBlockCleanIsPreserved(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $text = "Here is the result:\n```json\n{\"body\": \"<p>ok & fine</p>\"}\n```\nDone.";
+    $this->assertSame($text, $this->hostnameFilter->filterText($text));
+  }
+
+  /**
+   * Test that a bare fenced block surrounded by whitespace is preserved.
+   */
+  public function testBareFencedJsonBlockCleanIsPreserved(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $text = "```\n{\"a\": \"x < y\"}\n```";
+    $this->assertSame($text, $this->hostnameFilter->filterText($text));
+  }
+
+  /**
+   * Test that a violation inside a fenced JSON block is filtered.
+   */
+  public function testFencedJsonBlockWithViolationIsFilteredAndFenceRetained(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $text = "Result:\n```json\n{\"body\": \"<a href=\\\"https://evil.com/x\\\">c</a>\"}\n```";
+    $result = $this->hostnameFilter->filterText($text);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringContainsString('```json', $result);
+    $this->assertMatchesRegularExpression('/```json\s*\n(.*)\n\s*```/s', $result);
+    preg_match('/```json\s*\n(.*)\n\s*```/s', $result, $matches);
+    $this->assertIsArray(json_decode($matches[1], TRUE));
+  }
+
+  /**
+   * Test that prose around a fenced JSON block is filtered independently.
+   */
+  public function testFencedJsonWithViolationInSurroundingProse(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $payload = '{"a": "clean"}';
+    $text = "See [here](https://evil.com/x):\n```json\n$payload\n```";
+    $result = $this->hostnameFilter->filterText($text);
+    $this->assertStringNotContainsString('evil.com', $result);
+    // The payload itself is untouched.
+    $this->assertStringContainsString($payload, $result);
+  }
+
+  /**
+   * Test that JSON mode falls back to plain text for malformed JSON.
+   *
+   * A truncated structured output payload must not be entity-encoded by the
+   * HTML round trip; only the disallowed URL is removed.
+   */
+  public function testJsonModeFallsBackToPlainTextOnMalformedJson(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $this->hostnameFilter->setJsonMode(TRUE);
+    $malformed = '{"a": "see https://evil.com/x for details"';
+    $result = $this->hostnameFilter->filterText($malformed);
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringStartsWith('{"a": ', $result);
+    $this->assertStringNotContainsString('&quot;', $result);
+    $this->assertStringNotContainsString('&amp;', $result);
+  }
+
+  /**
+   * Test that JSON mode does not change handling of decodable payloads.
+   */
+  public function testJsonModeDecodablePayloadMatchesAutoDetection(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $json = '{"body":"<p>ok</p>"}';
+    $auto = $this->hostnameFilter->filterText($json);
+    $this->hostnameFilter->setJsonMode(TRUE);
+    $this->assertSame($auto, $this->hostnameFilter->filterText($json));
+    $this->assertSame($json, $auto);
+  }
+
+  /**
+   * Test that plain text mode takes precedence over JSON detection.
+   */
+  public function testPlainTextModeTakesPrecedenceOverJsonDetection(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $this->hostnameFilter->setPlainTextMode(TRUE);
+    $json = '{"url": "https://evil.com/x"}';
+    $result = $this->hostnameFilter->filterText($json);
+    // Plain text filtering removes the URL but performs no HTML encoding.
+    $this->assertStringNotContainsString('evil.com', $result);
+    $this->assertStringNotContainsString('&quot;', $result);
+  }
+
+  /**
+   * Test that full trust bypasses JSON handling entirely.
+   */
+  public function testFullTrustBypassesJsonHandling(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $this->hostnameFilter->setFullTrust(TRUE);
+    $json = '{"url": "<a href=\"https://evil.com/x\">x</a>"}';
+    $this->assertSame($json, $this->hostnameFilter->filterText($json));
+  }
+
+  /**
+   * Test that jsonMode round-trips through applySettings and snapshots.
+   */
+  public function testApplySettingsAndSnapshotRestoreRoundTripJsonMode(): void {
+    $this->hostnameFilter->setAllowedDomains(['example.com']);
+    $snapshot = $this->hostnameFilter->snapshotSettings();
+    $this->assertArrayHasKey('jsonMode', $snapshot);
+    $this->assertNull($snapshot['jsonMode']);
+
+    $dto = new HostnameFilterDto(jsonMode: TRUE);
+    $this->hostnameFilter->applySettings($dto);
+    // With jsonMode applied, malformed JSON is not HTML-encoded.
+    $malformed = '{"a": "x < y"';
+    $this->assertSame($malformed, $this->hostnameFilter->filterText($malformed));
+
+    // Restoring reverts to the regular pipeline, which mangles the
+    // malformed payload again — proving the flag was actually restored.
+    $this->hostnameFilter->restoreSettings($snapshot);
+    $this->assertNotSame($malformed, $this->hostnameFilter->filterText($malformed));
+  }
+
 }
