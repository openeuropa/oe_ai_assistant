<?php

/**
 * @file
 * Install hooks for the OE AI Assistant Test module.
 */

declare(strict_types=1);

use Drupal\Core\File\FileExists;
use Drupal\file\Entity\File;
use Drupal\file\FileInterface;
use Drupal\oe_ai_assistant\Entity\AiDraftingTemplate;
use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_install().
 *
 * Configures AI defaults and providers for the test environment.
 */
function oe_ai_assistant_test_install(): void {
  $configFactory = \Drupal::configFactory();

  // Set GPT@EC as the default LLM provider for all operation types.
  $configFactory->getEditable('ai.settings')
    ->set('default_providers', [
      'chat' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_complex_json' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_image_vision' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_structured_response' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_tools' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
    ])
    ->save();

  // Point the GPT@EC provider to the Key entity for the API key.
  $configFactory->getEditable('oe_ai_provider_gpt_at_ec.settings')
    ->set('api_key', 'gpt_at_ec_key')
    ->save();

  // Point the OpenAI provider to the Key entity for the API key.
  $configFactory->getEditable('ai_provider_openai.settings')
    ->set('api_key', 'openai_api_key')
    ->set('moderation', FALSE)
    ->save();

  oe_ai_assistant_test_install_editorial_taxonomy_terms();

  $heroImage = oe_ai_assistant_test_install_default_hero_image();
  oe_ai_assistant_test_install_news_with_hero_template($heroImage);
}

/**
 * Installs the default hero image.
 *
 * Copies the module's bundled placeholder image into the public files
 * directory and creates a permanent File entity for it.
 *
 * Done in code rather than as config/install content, and ahead of the
 * 'news_with_hero' template it feeds: config entities in /install are
 * validated and saved before hook_install() runs, so a template shipped as
 * YAML could never resolve a target_uuid pointing at this file - the file
 * wouldn't exist yet.
 *
 * @return \Drupal\file\FileInterface
 *   The saved default hero image file.
 */
function oe_ai_assistant_test_install_default_hero_image(): FileInterface {
  $fileSystem = \Drupal::service('file_system');
  $moduleHandler = \Drupal::service('module_handler');

  $source = $moduleHandler->getModule('oe_ai_assistant_test')->getPath() . '/assets/hero-default.jpg';
  $destinationDirectory = 'public://oe_ai_assistant_test';
  $fileSystem->prepareDirectory($destinationDirectory, $fileSystem::CREATE_DIRECTORY);

  $destination = $fileSystem->copy($source, $destinationDirectory . '/hero-default.jpg', FileExists::Replace);

  $file = File::create([
    'uri' => $destination,
    'filename' => 'hero-default.jpg',
    'filemime' => 'image/jpeg',
    'status' => FileInterface::STATUS_PERMANENT,
  ]);
  $file->save();

  return $file;
}

/**
 * Installs the 'news_with_hero' drafting template.
 *
 * Pins the given file as the hero paragraph's image via an item-level
 * default (target_uuid resolution), so drafting an oe_news article with
 * this template shows the hero paragraph with its image already in place
 * whenever the LLM adds one. text_block and quote_block are also offered
 * so the LLM has real content to draft alongside it.
 *
 * @param \Drupal\file\FileInterface $heroImage
 *   The default hero image, as saved by
 *   oe_ai_assistant_test_install_default_hero_image().
 */
function oe_ai_assistant_test_install_news_with_hero_template(FileInterface $heroImage): void {
  AiDraftingTemplate::create([
    'id' => 'news_with_hero',
    'label' => 'News article with hero image',
    'status' => TRUE,
    'description' => 'News article with a hero paragraph whose image defaults to the bundled placeholder, demonstrating item-level template defaults.',
    'content_type' => 'oe_news',
    'fields' => [
      'title' => ['prompt' => 'News headline, max 80 characters.'],
      'field_teaser' => ['prompt' => 'One-sentence teaser for the article.'],
      'field_content_paragraphs' => [
        'type' => 'entity_reference_revisions',
        'items' => [
          [
            'entity_type' => 'paragraph',
            'bundle' => 'hero',
            'prompt' => 'Hero banner for the article. Always place this as the first paragraph, before any other content.',
            'defaults' => [
              'field_hero_image' => [
                'default_value' => [
                  [
                    'target_uuid' => $heroImage->uuid(),
                    'alt' => 'Default hero image',
                  ],
                ],
              ],
            ],
          ],
          [
            'entity_type' => 'paragraph',
            'bundle' => 'text_block',
            'prompt' => 'Introductory text, 1-2 paragraphs.',
            'fields' => [
              'field_text_body' => ['prompt' => 'Introduction body text.'],
            ],
          ],
          [
            'entity_type' => 'paragraph',
            'bundle' => 'quote_block',
            'prompt' => 'A relevant quote from a key stakeholder.',
            'fields' => [
              'field_quote_text' => ['prompt' => 'The quote text.'],
              'field_quote_attribution' => ['prompt' => 'Full name and title of the person being quoted.'],
            ],
          ],
        ],
      ],
    ],
    'defaults' => [
      'langcode' => ['default_value' => [['value' => 'en']]],
    ],
  ])->save();
}

/**
 * Installs the default editorial taxonomy terms used by tests.
 */
function oe_ai_assistant_test_install_editorial_taxonomy_terms(): void {
  foreach (oe_ai_assistant_test_get_editorial_taxonomy_terms() as $vid => $terms) {
    foreach ($terms as $name => $text) {
      $term = Term::create([
        'vid' => $vid,
        'name' => $name,
        'description' => [
          'value' => $text['description'],
          'format' => 'plain_text',
        ],
        'field_oe_ai_prompt' => $text['prompt'],
      ]);
      $term->save();
    }
  }
}

/**
 * Returns the default editorial taxonomy terms keyed by vocabulary.
 *
 * @return array<string, array<string, string>>
 *   The default term labels keyed to their editor and prompt guidance text.
 */
function oe_ai_assistant_test_get_editorial_taxonomy_terms(): array {
  return [
    'oe_ai_tone' => [
      'Conversational' => [
        'description' => 'A friendly and informal tone that speaks directly to the reader.',
        'prompt' => 'Write in a friendly, approachable style. Use contractions naturally. Address the reader directly. Keep sentences varied in length.',
      ],
      'Formal' => [
        'description' => 'A professional and neutral tone suitable for official or institutional communication.',
        'prompt' => 'Use professional, institutional language. Maintain a neutral, authoritative voice. Avoid contractions and colloquialisms.',
      ],
      'Inspirational' => [
        'description' => 'A motivating and forward-looking tone that emphasizes positive outcomes and shared goals.',
        'prompt' => 'Use forward-looking, motivational language. Emphasize positive outcomes and shared goals. Appeal to values and aspirations.',
      ],
      'Technical' => [
        'description' => 'A detailed and structured tone using specialized terminology for expert contexts.',
        'prompt' => 'Use domain-specific terminology precisely. Include technical detail and data. Structure content with clear headings and logical flow.',
      ],
    ],
  ];
}
