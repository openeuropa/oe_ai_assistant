<?php

/**
 * @file
 * Install hooks for the OE AI Assistant Test module.
 */

declare(strict_types=1);

use Drupal\Core\File\FileSystem;
use Drupal\Core\Site\Settings;
use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_install().
 *
 * Configures AI defaults and providers for the test environment.
 */
function oe_ai_assistant_test_install(): void {
  oe_ai_assistant_test_ensure_private_file_path();

  $configFactory = \Drupal::configFactory();

  // Set GPT@EC as the default LLM provider for all operation types.
  $configFactory->getEditable('ai.settings')
    ->set('default_providers', [
      'chat' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_complex_json' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_structured_response' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_tools' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
      'chat_with_image_vision' => [
        'provider_id' => 'gpt_at_ec',
        'model_id' => 'gpt-5.1',
      ],
    ])
    ->save();

  // Point the GPT@EC provider to the Key entity for the API key.
  $configFactory->getEditable('oe_ai_provider_gpt_at_ec.settings')
    ->set('api_key', 'gpt_at_ec_key')
    ->save();

  // Point the OpenAI provider to the Key entity for the API key.
  $configFactory->getEditable('ai_provider_openai.settings')
    ->set('api_key', 'openai_api_key')
    ->set('moderation', FALSE)
    ->save();

  oe_ai_assistant_test_install_editorial_taxonomy_terms();
}

/**
 * Ensures the test site has a usable private file path.
 */
function oe_ai_assistant_test_ensure_private_file_path(): void {
  $privatePath = Settings::get('file_private_path');
  if (!is_string($privatePath) || $privatePath === '') {
    $sitePath = \Drupal::getContainer()->getParameter('site.path');
    $privatePath = DRUPAL_ROOT . '/' . $sitePath . '/private';
    new Settings(array_replace(Settings::getAll(), [
      'file_private_path' => $privatePath,
    ]));
    oe_ai_assistant_test_append_private_file_path_setting($privatePath);
  }

  if (!is_dir($privatePath)) {
    mkdir($privatePath, 0775, TRUE);
  }
  \Drupal::service('file_system')->chmod($privatePath, FileSystem::CHMOD_DIRECTORY);
}

/**
 * Appends the private file path setting to settings.php for later requests.
 */
function oe_ai_assistant_test_append_private_file_path_setting(string $privatePath): void {
  $settingsFile = DRUPAL_ROOT . '/' . \Drupal::getContainer()->getParameter('site.path') . '/settings.php';
  if (!is_writable($settingsFile)) {
    return;
  }

  $contents = file_get_contents($settingsFile);
  if ($contents !== FALSE && str_contains($contents, 'OE AI Assistant Test private file path')) {
    return;
  }

  file_put_contents(
    $settingsFile,
    "\n// OE AI Assistant Test private file path.\n"
    . "\$settings['file_private_path'] = " . var_export($privatePath, TRUE) . ";\n",
    FILE_APPEND,
  );
}

/**
 * Installs the default editorial taxonomy terms used by tests.
 */
function oe_ai_assistant_test_install_editorial_taxonomy_terms(): void {
  foreach (oe_ai_assistant_test_get_editorial_taxonomy_terms() as $vid => $terms) {
    foreach ($terms as $name => $text) {
      $term = Term::create([
        'vid' => $vid,
        'name' => $name,
        'description' => [
          'value' => $text['description'],
          'format' => 'plain_text',
        ],
        'field_oe_ai_prompt' => $text['prompt'],
      ]);
      $term->save();
    }
  }
}

/**
 * Returns the default editorial taxonomy terms keyed by vocabulary.
 *
 * @return array<string, array<string, string>>
 *   The default term labels keyed to their editor and prompt guidance text.
 */
function oe_ai_assistant_test_get_editorial_taxonomy_terms(): array {
  return [
    'oe_ai_tone' => [
      'Conversational' => [
        'description' => 'A friendly and informal tone that speaks directly to the reader.',
        'prompt' => 'Write in a friendly, approachable style. Use contractions naturally. Address the reader directly. Keep sentences varied in length.',
      ],
      'Formal' => [
        'description' => 'A professional and neutral tone suitable for official or institutional communication.',
        'prompt' => 'Use professional, institutional language. Maintain a neutral, authoritative voice. Avoid contractions and colloquialisms.',
      ],
      'Inspirational' => [
        'description' => 'A motivating and forward-looking tone that emphasizes positive outcomes and shared goals.',
        'prompt' => 'Use forward-looking, motivational language. Emphasize positive outcomes and shared goals. Appeal to values and aspirations.',
      ],
      'Technical' => [
        'description' => 'A detailed and structured tone using specialized terminology for expert contexts.',
        'prompt' => 'Use domain-specific terminology precisely. Include technical detail and data. Structure content with clear headings and logical flow.',
      ],
    ],
  ];
}
