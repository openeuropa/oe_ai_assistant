<?php

/**
 * @file
 * Install hooks for the OE AI Assistant Agent Test module.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 *
 * Sets the mock AI provider as the default for all chat operation types.
 */
function oe_ai_assistant_agent_test_install(): void {
  \Drupal::configFactory()->getEditable('ai.settings')
    ->set('default_providers', [
      'chat' => [
        'provider_id' => 'mock_ai',
        'model_id' => 'mock-model',
      ],
      'chat_with_tools' => [
        'provider_id' => 'mock_ai',
        'model_id' => 'mock-model',
      ],
      'chat_with_complex_json' => [
        'provider_id' => 'mock_ai',
        'model_id' => 'mock-model',
      ],
      'chat_with_image_vision' => [
        'provider_id' => 'mock_ai',
        'model_id' => 'mock-model',
      ],
      'chat_with_structured_response' => [
        'provider_id' => 'mock_ai',
        'model_id' => 'mock-model',
      ],
    ])
    ->save();
}
