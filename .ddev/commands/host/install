#!/bin/bash

## Description: Install the test Drupal site and enable the module
## Usage: install
## Example: ddev install

set -e

echo "Installing dependencies..."
ddev poser

echo "Symlinking module into Drupal..."
export PROJECT_FILES=$(ls -A)
ddev symlink-project

echo "Installing Drupal with minimal profile..."
ddev drush site:install minimal --account-name=admin --account-pass=admin -y

echo "Enabling test module discovery..."
ddev exec 'grep -q extension_discovery_scan_tests web/sites/default/settings.php 2>/dev/null || echo "\$settings[\"extension_discovery_scan_tests\"] = TRUE;" >> web/sites/default/settings.php'

echo "Installing and setting Seven as default and admin theme..."
ddev drush theme:install seven -y
ddev drush config:set system.theme default seven -y
ddev drush config:set system.theme admin seven -y

echo "Enabling toolbar and field_ui..."
ddev drush en toolbar field_ui -y

echo "Enabling oe_ai_assistant and test module..."
ddev drush en oe_ai_assistant oe_ai_assistant_test -y

echo "Setting admin password..."
ddev drush user:password admin admin

echo "Clearing caches..."
ddev drush cr

echo ""
echo "Site installed successfully!"
echo "Admin login: admin / admin"
echo "URL: $(ddev describe -j 2>/dev/null | php -r 'echo json_decode(file_get_contents("php://stdin"))->raw->primary_url;' 2>/dev/null || echo 'Run ddev describe to see the URL')"
