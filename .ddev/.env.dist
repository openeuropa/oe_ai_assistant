DRUPAL_OPENAI_KEY=
KEY_AI_GPT_AT_EC=

# AI provider configuration. Uncomment the provider you want to use.

# GPT at EC (default):
AI_PROVIDER=gpt_at_ec
AI_MODEL=gpt-5.1
AI_EMBED_MODEL=gpt-5.1

# OpenAI:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# AI_EMBED_MODEL=text-embedding-3-large

# Set to 1 to let settings.ai.php apply the AI provider config above.
# Leave unset so PHPUnit tests can set the provider via config API
# (e.g. the mock_ai provider). Read from this file at runtime, so
# changes take effect without restarting the containers.
#OE_AI_PROVIDER_OVERRIDE=1
