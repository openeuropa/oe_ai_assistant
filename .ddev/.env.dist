DRUPAL_OPENAI_KEY=
KEY_AI_GPT_AT_EC=

# AI provider configuration. Uncomment the provider you want to use.

# GPT at EC (default):
AI_PROVIDER=gpt_at_ec
AI_MODEL=gpt-5.1
AI_EMBED_MODEL=gpt-5.1

# OpenAI:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# AI_EMBED_MODEL=text-embedding-3-large

# When set to 1, settings.ai.php will not override the AI provider
# config. This allows PHPUnit tests to set the provider via config API
# (e.g. to use the mock_ai provider).
OE_AI_SKIP_PROVIDER_OVERRIDE=1
